# Pandas Practice - Sales Data Cleaning

### Importing libraries

import pandas as pd
import numpy as np

print("done")

### Loading the dataset

df = pd.read_csv('raw_sales_data.csv')
print(df.shape)

# checking data type
df.head()

df.tail()

### Exploring the structure

shape, columns, dtypes 

print("Rows:", df.shape[0])
print("Columns:", df.shape[1])

df.columns.tolist()

df.dtypes

# info() 
df.info()

# numeric columns 
df.describe()

### Missing values

info() 

df.isnull().sum()

# percentage 
(df.isnull().sum() / len(df) * 100).round(1)



df['price'] = df.groupby('product')['price'].transform(
    lambda x: x.fillna(x.median())
)

# check 
df['price'].isnull().sum()


df['quantity'] = df['quantity'].fillna(1).astype(int)

print("quantity nulls left:", df['quantity'].isnull().sum())


df['region'] = df['region'].fillna('Unknown')

# final check
df.isnull().sum()

### Filtering and selecting

df[['order_id', 'customer_name', 'product', 'price', 'quantity']].head()

# only electronics orders
electronics = df[df['category'] == 'Electronics']
print(f"{len(electronics)} electronics orders found")
electronics.head()

# expensive orders — price > 10000
df[df['price'] > 10000][['order_id', 'product', 'price', 'region']]

# multiple conditions 
df[(df['region'] == 'North') & (df['category'] == 'Electronics')]

### Duplicates

print("duplicate rows:", df.duplicated().sum())

# duplicate rows 
df[df.duplicated(keep=False)].sort_values('order_id')

# order 1025 is twice 
df = df.drop_duplicates()
print("after dropping:", df.shape)

### Creating total_amount column

df['total_amount'] = df['price'] * df['quantity']

df[['order_id', 'product', 'price', 'quantity', 'total_amount']].head(8)

# total revenue 
print("Total revenue: ₹", df['total_amount'].sum())

# category wise revenue 
df.groupby('category')['total_amount'].sum().sort_values(ascending=False)

### Saving the cleaned file

# index reset 
df = df.reset_index(drop=True)
df.head()

df.to_csv('cleaned_sales_data.csv', index=False)
print("saved! final shape:", df.shape)

### What I did (quick summary)

- loaded the csv, it had 31 rows and 8 columns  
- found nulls in `price` (2), `quantity` (1), `region` (1)  
- filled price using product-wise median instead of overall mean  
- removed 1 duplicate row (order 1025 appeared twice)  
- added `total_amount` column  
- saved cleaned version with 30 rows and 9 columns  

